# Optional server-side path. The default is <project>/.local/catalogue.sqlite3.
# The application reads the process environment; it does not auto-load this file.
# TOROB_DATABASE=D:/starcoach/torob/.local/catalogue.sqlite3
# Production: mount a persistent disk at /data and copy BOTH existing databases.
# TOROB_DATABASE=/data/catalogue.sqlite3
# TOROB_USAGE_DATABASE=/data/agent-usage.sqlite3
# TOROB_WEB_DIST=/app/apps/web/dist
# PORT=8000

# Only the allowlisted assistant settings below may also be read from root .env.local.
# Process environment takes precedence. NEVER put a real key in this example or VITE_*.
TOROB_ASSISTANT_ENABLED=0
BOXAPI_API_KEY=
TOROB_ASSISTANT_MODEL=gpt-5.6-luna
# Persistent total attempt cap (1..500); failed/cancelled attempts count. Increase deliberately.
TOROB_ASSISTANT_ATTEMPT_LIMIT=3

# Voice is opt-in; these settings are SERVER ENVIRONMENT only, not .env.local.
# Never use VITE_* for credentials. Model settings/caps above are unchanged.
TOROB_VOICE_ENABLED=0
AVALAI_API_KEY=
# AVALAI_BASE_URL=https://api.avalai.ir/v1
