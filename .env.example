# Optional server-side path. The default is <project>/.local/catalogue.sqlite3.
# The application reads the process environment; it does not auto-load this file.
# TOROB_DATABASE=D:/starcoach/torob/.local/catalogue.sqlite3

# Only the allowlisted assistant settings below may also be read from root .env.local.
# Process environment takes precedence. NEVER put a real key in this example or VITE_*.
TOROB_ASSISTANT_ENABLED=0
BOXAPI_API_KEY=
TOROB_ASSISTANT_MODEL=gpt-5.6-luna
# Persistent total attempt cap (1..200); failed/cancelled attempts count. Increase deliberately.
TOROB_ASSISTANT_ATTEMPT_LIMIT=3
