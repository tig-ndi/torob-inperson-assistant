# Local BoxAPI connection. Paste your key here, then restart run-local.ps1.
BOXAPI_API_KEY=
TOROB_ASSISTANT_ENABLED=1
TOROB_ASSISTANT_MODEL=gpt-5.6-luna
# Persistent total attempt cap; failed attempts count too.
TOROB_ASSISTANT_ATTEMPT_LIMIT=3

# Optional separate speech service, disabled until configured deliberately.
TOROB_VOICE_ENABLED=0
AVALAI_API_KEY=
